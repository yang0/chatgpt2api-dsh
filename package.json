{
  "name": "dsh-plugin-chatgpt2api",
  "version": "0.6.0",
  "type": "module",
  "private": true,
  "description": "Cross-platform DSH standalone account pool and local OpenAI-compatible image/text API; no Docker",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./provider": "./lib/provider.js",
    "./package.json": "./package.json",
    "./windows-backend": "./lib/windows-backend.js",
    "./credential-vault": "./lib/credential-vault.js",
    "./platform-backend": "./lib/platform-backend.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "types",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "status": "node scripts/manage-backend.mjs status",
    "diagnose": "node scripts/manage-backend.mjs log"
  },
  "license": "MIT",
  "homepage": "https://github.com/basketikun/chatgpt2api"
}
